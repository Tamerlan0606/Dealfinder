# open = test everything without payment. x402 = require USDC payment before paid routes execute.
WORKMINE_PAYMENT_MODE=open

# Public EVM receive address. A seller address only; NEVER put a private key here.
PAY_TO=

# Base mainnet. Use eip155:84532 for Base Sepolia testing.
X402_NETWORK=eip155:8453
X402_FACILITATOR_URL=https://x402.org/facilitator

# Set this to the deployed HTTPS origin so Bazaar metadata contains absolute resource URLs.
PUBLIC_BASE_URL=

WORKMINE_DB_PATH=/tmp/workmine.db
MAX_TEXT_CHARS=200000
MAX_PDF_BYTES=8388608
